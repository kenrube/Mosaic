<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.App" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_500</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="android:windowBackground">@color/grey_900</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.App.Dialog.Alert</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheetDialog</item>
    </style>

    <style name="ThemeOverlay.App.Dialog.Alert" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="buttonBarButtonStyle">@style/Widget.App.Button.TextButton.Dialog</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.App.Caption</item>
    </style>

    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet</item>
        <item name="android:windowAnimationStyle">@style/Animation.App.BottomSheetDialog</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>
</resources>