<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/filter_item_size"
    android:layout_height="@dimen/filter_item_size"
    android:foreground="@drawable/selector_white_010"
    app:cardElevation="2dp">

    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        tools:src="@tools:sample/avatars" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_gravity="bottom"
        android:background="@color/white_0c0"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/grey_800"
        android:textSize="12sp"
        tools:text="Filter title" />

    <FrameLayout
        android:id="@+id/selected"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@drawable/layer_list_stroke_yellow_600"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="@dimen/filter_item_dots_size"
            android:layout_height="@dimen/filter_item_dots_size"
            android:layout_gravity="center"
            android:contentDescription="@string/filter_intensity"
            android:src="@drawable/ic_dots_horizontal_24" />

    </FrameLayout>

</androidx.cardview.widget.CardView>